generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// test de synchro
// ============================================
// AN - MANAGEMENT
// ============================================
model ParamLegislature {
  id        Int       @id @default(autoincrement())
  number    Int       @unique
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  currentLegislatures ParamCurrentLegislature[]
  dataSources         ParamDataSource[]

  @@map("param_legislatures")
}

model ParamCurrentLegislature {
  legislatureId Int              @id @map("legislature_id")
  number        Int
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at")
  legislature   ParamLegislature @relation(fields: [legislatureId], references: [id])

  @@map("param_current_legislatures")
}

model RefDataDomain {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String?

  dataSources ParamDataSource[]

  @@map("ref_data_domains")
}

model ParamDataSource {
  id            Int      @id @default(autoincrement())
  domainId      Int      @map("domain_id")
  legislatureId Int      @map("legislature_id")
  downloadUrl   String   @map("download_url")
  fileName      String   @map("file_name")
  createdAt     DateTime @default(now()) @map("created_at")

  domain      RefDataDomain         @relation(fields: [domainId], references: [id])
  legislature ParamLegislature      @relation(fields: [legislatureId], references: [id])
  downloads   MonitorDataDownload[]

  @@unique([domainId, legislatureId])
  @@map("param_data_sources")
}

model MonitorDataDownload {
  id             Int       @id @default(autoincrement())
  sourceId       Int       @map("source_id")
  fileName       String?   @map("file_name")
  downloaded     Boolean   @default(false)
  lastDownloadAt DateTime? @map("last_download_at")
  checksum       String?
  fileSize       BigInt?   @map("file_size")
  errorMessage   String?   @map("error_message")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  source ParamDataSource @relation(fields: [sourceId], references: [id])

  @@unique([sourceId])
  @@map("monitor_data_download")
}

model MonitorDataSetsUpdate {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("monitor_data_set_update")
}

// ============================================
// ACTEURS
// ============================================
model Acteurs {
  uid                   String    @id @db.VarChar(50)
  civilite              String?   @db.VarChar(10)
  prenom                String?   @db.VarChar(100)
  nom                   String?   @db.VarChar(255)
  nom_alpha             String?   @db.VarChar(255)
  trigramme             String?   @db.VarChar(10)
  date_naissance        DateTime? @db.Date
  ville_naissance       String?   @db.VarChar(255)
  departement_naissance String?   @db.VarChar(255)
  pays_naissance        String?   @db.VarChar(255)
  date_deces            DateTime? @db.Date
  profession_libelle    String?   @db.VarChar(255)
  profession_categorie  String?   @db.VarChar(255)
  profession_famille    String?   @db.VarChar(255)
  uri_hatvp             String?   @db.Text
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  row_hash              String    @db.Text
  legislature_snapshot  Int       @db.Integer

  adressesPostales ActeursAdressesPostales[]
  adressesMails    ActeursAdressesMails[]
  reseauxSociaux   ActeursReseauxSociaux[]
  telephones       ActeursTelephones[]
  mandats          Mandats[]
  photos           RefActeursPhotos[]
  groupes          ActeursGroupes[]

  @@unique([row_hash])
  @@map("acteurs")
}

model ActeursAdressesPostales {
  id                   Int      @id @default(autoincrement())
  acteur_uid           String   @db.VarChar(50)
  uid_adresse          String   @db.VarChar(50)
  type_code            String?  @db.VarChar(10)
  type_libelle         String?  @db.VarChar(255)
  intitule             String?  @db.VarChar(255)
  numero_rue           String?  @db.VarChar(50)
  nom_rue              String?  @db.VarChar(255)
  complement_adresse   String?  @db.VarChar(255)
  code_postal          String?  @db.VarChar(10)
  ville                String?  @db.VarChar(255)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  acteur Acteurs @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([uid_adresse])
  @@map("acteurs_adresses_postales")
}

model ActeursAdressesMails {
  id                   Int      @id @default(autoincrement())
  acteur_uid           String   @db.VarChar(50)
  uid_adresse          String   @db.VarChar(50)
  type_code            String?  @db.VarChar(10)
  type_libelle         String?  @db.VarChar(255)
  email                String?  @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  acteur Acteurs @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([uid_adresse])
  @@map("acteurs_adresses_mails")
}

model ActeursReseauxSociaux {
  id                   Int      @id @default(autoincrement())
  acteur_uid           String   @db.VarChar(50)
  uid_adresse          String   @db.VarChar(50)
  type_code            String?  @db.VarChar(10)
  type_libelle         String?  @db.VarChar(255)
  plateforme           String?  @db.VarChar(50)
  identifiant          String?  @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  acteur Acteurs @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([uid_adresse])
  @@map("acteurs_reseaux_sociaux")
}

model ActeursTelephones {
  id                   Int      @id @default(autoincrement())
  acteur_uid           String   @db.VarChar(50)
  uid_adresse          String   @db.VarChar(50)
  type_code            String?  @db.VarChar(10)
  type_libelle         String?  @db.VarChar(255)
  adresse_rattachement String?  @db.VarChar(50)
  numero               String?  @db.VarChar(100)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  acteur Acteurs @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([uid_adresse])
  @@map("acteurs_telephones")
}

model ActeursGroupes {
  id                   Int       @id @default(autoincrement())
  acteur_uid           String    @db.VarChar(50)
  groupe_id            String    @db.VarChar(50)
  groupe_legislature   Int
  date_debut           DateTime  @db.Date
  date_fin             DateTime? @db.Date
  legislature_snapshot Int       @db.Integer
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  row_hash             String    @db.Text

  acteur Acteurs               @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)
  groupe GroupesParlementaires @relation(fields: [groupe_id], references: [id])

  @@unique([row_hash])
  @@unique([acteur_uid, groupe_id, date_debut])
  @@index([acteur_uid])
  @@index([groupe_id])
  @@index([legislature_snapshot])
  @@map("acteurs_groupes")
}

// ============================================
// DÉPUTÉS & SCRUTINS
// ============================================
model Deputes {
  id                   String   @id @db.VarChar(50)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  votes VotesDeputes[]

  @@unique([row_hash])
  @@unique([id])
  @@map("deputes")
}

model Scrutins {
  uid                  String    @id @db.VarChar(50)
  numero               String?   @db.VarChar(10)
  legislature          String?   @db.VarChar(10)
  date_scrutin         DateTime? @db.Date
  titre                String?   @db.Text
  type_scrutin_code    String?   @db.VarChar(10)
  type_scrutin_libelle String?   @db.VarChar(255)
  type_majorite        String?   @db.Text
  resultat_code        String?   @db.VarChar(50)
  resultat_libelle     String?   @db.Text
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  row_hash             String    @db.Text
  legislature_snapshot Int       @db.Integer

  scrutinsGroupes         ScrutinsGroupes[]
  votesDeputes            VotesDeputes[]
  agregats                ScrutinsAgregats?
  scrutinsGroupesAgregats ScrutinsGroupesAgregats[]

  @@unique([row_hash])
  @@unique([uid]) // Un scrutin est unique
  @@index([legislature_snapshot])
  @@map("scrutins")
}

model ScrutinsGroupes {
  id                   Int      @id @default(autoincrement())
  scrutin_uid          String   @db.VarChar(50)
  groupe_id            String   @db.VarChar(50)
  groupe_legislature   Int
  nombre_membres       Int?
  position_majoritaire String?  @db.VarChar(50)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  scrutin Scrutins              @relation(fields: [scrutin_uid], references: [uid], onDelete: Cascade)
  groupe  GroupesParlementaires @relation(fields: [groupe_id], references: [id])

  @@unique([row_hash])
  @@unique([scrutin_uid, groupe_id]) // Un groupe ne peut apparaître qu'une fois par scrutin
  @@index([scrutin_uid])
  @@index([legislature_snapshot])
  @@map("scrutins_groupes")
}

model VotesDeputes {
  id                   Int      @id @default(autoincrement())
  scrutin_uid          String   @db.VarChar(50)
  depute_id            String   @db.VarChar(50)
  groupe_id            String?  @db.VarChar(50)
  groupe_legislature   Int?
  mandat_ref           String?  @db.VarChar(50)
  position             String   @db.VarChar(20)
  cause_position       String?  @db.VarChar(10)
  par_delegation       Boolean?
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  scrutin Scrutins               @relation(fields: [scrutin_uid], references: [uid], onDelete: Cascade)
  depute  Deputes                @relation(fields: [depute_id], references: [id])
  groupe  GroupesParlementaires? @relation(fields: [groupe_id], references: [id])

  @@unique([row_hash])
  @@unique([scrutin_uid, depute_id]) // Un député ne peut voter qu'une fois par scrutin
  @@index([scrutin_uid])
  @@index([depute_id])
  @@index([legislature_snapshot])
  @@index([groupe_id])
  @@map("votes_deputes")
}

model ScrutinsAgregats {
  scrutin_uid                   String   @id @db.VarChar(50)
  nombre_votants                Int?
  suffrages_exprimes            Int?
  suffrages_requis              Int?
  total_pour                    Int?
  total_contre                  Int?
  total_abstentions             Int?
  total_non_votants             Int?
  total_non_votants_volontaires Int?
  created_at                    DateTime @default(now()) @db.Timestamp(6)
  row_hash                      String   @db.Text
  legislature_snapshot          Int      @db.Integer

  scrutin Scrutins @relation(fields: [scrutin_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([scrutin_uid]) // Un scrutin ne peut avoir qu'un agrégat
  @@index([legislature_snapshot])
  @@map("scrutins_agregats")
}

model ScrutinsGroupesAgregats {
  id                      Int      @id @default(autoincrement())
  scrutin_uid             String   @db.VarChar(50)
  groupe_id               String   @db.VarChar(50)
  groupe_legislature      Int
  pour                    Int?
  contre                  Int?
  abstentions             Int?
  non_votants             Int?
  non_votants_volontaires Int?
  created_at              DateTime @default(now()) @db.Timestamp(6)
  row_hash                String   @db.Text
  legislature_snapshot    Int      @db.Integer

  scrutin Scrutins              @relation(fields: [scrutin_uid], references: [uid], onDelete: Cascade)
  groupe  GroupesParlementaires @relation(fields: [groupe_id], references: [id])

  @@unique([row_hash])
  @@unique([scrutin_uid, groupe_id]) // Un groupe ne peut avoir qu'un agrégat par scrutin
  @@index([scrutin_uid])
  @@index([legislature_snapshot])
  @@map("scrutins_groupes_agregats")
}

// ============================================
// MANDATS
// ============================================
model Mandats {
  uid                           String    @id @db.VarChar(50)
  acteur_uid                    String    @db.VarChar(50)
  legislature                   Int
  type_organe                   String    @db.VarChar(50)
  date_debut                    DateTime  @db.Date
  date_fin                      DateTime? @db.Date
  date_publication              DateTime? @db.Date
  preseance                     Int
  nomin_principale              Int
  code_qualite                  String    @db.VarChar(100)
  lib_qualite                   String    @db.VarChar(255)
  lib_qualite_sex               String    @db.VarChar(255)
  organe_uid                    String    @db.VarChar(100)
  election_region               String?   @db.VarChar(255)
  election_region_type          String?   @db.VarChar(100)
  election_departement          String?   @db.VarChar(255)
  election_num_departement      String?   @db.VarChar(10)
  election_num_circo            String?   @db.VarChar(10)
  election_cause_mandat         String?   @db.VarChar(255)
  election_ref_circonscription  String?   @db.VarChar(255)
  mandature_date_prise_fonction DateTime? @db.Date
  mandature_cause_fin           String?   @db.VarChar(255)
  mandature_premiere_election   Boolean?
  mandature_place_hemicycle     String?   @db.VarChar(10)
  mandature_mandat_remplace_ref String?   @db.VarChar(100)
  created_at                    DateTime  @default(now()) @db.Timestamp(6)
  row_hash                      String    @db.Text
  legislature_snapshot          Int       @db.Integer

  acteur     Acteurs             @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)
  suppleants MandatsSuppleants[]

  @@unique([row_hash])
  @@index([acteur_uid])
  @@index([legislature_snapshot])
  @@map("mandats")
}

model MandatsSuppleants {
  id                   Int       @id @default(autoincrement())
  mandat_uid           String    @db.VarChar(50)
  suppleant_uid        String    @db.VarChar(50)
  date_debut           DateTime  @db.Date
  date_fin             DateTime? @db.Date
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  row_hash             String    @db.Text
  legislature_snapshot Int       @db.Integer

  mandat Mandats @relation(fields: [mandat_uid], references: [uid], onDelete: Cascade)

  @@unique([mandat_uid, suppleant_uid])
  @@unique([row_hash])
  @@index([legislature_snapshot])
  @@map("mandats_suppleants")
}

// ============================================
// RÉFÉRENTIELS
// ============================================

model GroupesParlementaires {
  id                   String   @id @db.VarChar(50)
  legislature_snapshot Int      @db.Integer
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text

  refGroupes              RefGroupes[]
  acteursGroupes          ActeursGroupes[]
  scrutinsGroupes         ScrutinsGroupes[]
  votesDeputes            VotesDeputes[]
  scrutinsGroupesAgregats ScrutinsGroupesAgregats[]

  @@unique([row_hash])
  @@map("groupes_parlementaires")
}

/// Organes de l'Assemblée nationale (jeu AMO, fichiers `acteurs/json/organe`) :
/// commissions (COMPER…), groupes (GP), ministères (MINISTERE), gouvernements
/// (GOUVERNEMENT), Présidence de la République (PRESREP)… Référencés par
/// `mandats.organe_uid`, sans clé étrangère : un mandat peut viser un organe
/// absent des archives importées.
model Organes {
  uid                  String    @id @db.VarChar(50)
  code_type            String    @db.VarChar(30)
  libelle              String?   @db.Text
  /// Forme à insérer dans une phrase : « de la commission des finances ».
  libelle_edition      String?   @db.Text
  /// Forme courte : « Finances », « Intérieur ».
  libelle_abrege       String?   @db.Text
  /// Sigle : « CION_FIN », « INT ».
  libelle_abrev        String?   @db.VarChar(50)
  date_debut           DateTime? @db.Date
  date_fin             DateTime? @db.Date
  /// Organe parent (ex. le gouvernement d'un ministère).
  organe_parent_uid    String?   @db.VarChar(50)
  /// Organe précédent (ex. le même ministère dans le gouvernement précédent).
  organe_precedent_uid String?   @db.VarChar(50)
  /// Rang protocolaire (ministères).
  preseance            Int?
  /// Législature de l'organe ; null pour un organe permanent.
  legislature          Int?
  legislature_snapshot Int
  row_hash             String    @unique @db.Text
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@index([code_type])
  @@index([organe_parent_uid])
  @@map("organes")
}

// ============================================
// REUNIONS (agenda : commissions, séances publiques, groupes d'études…)
// ============================================

/// Réunion de l'agenda de l'Assemblée (jeu « Réunions », un fichier par
/// réunion). `organe_uid` vise `organes.uid` sans clé étrangère : la commission
/// d'une réunion peut manquer des archives AMO importées (ex. organes du Sénat
/// pour les réunions communes).
model Reunions {
  uid                        String    @id @db.VarChar(50)
  /// commission | seance | init_parlementaire
  type_reunion               String    @db.VarChar(30)
  /// Législature portée par l'uid (RUANR5L17…).
  legislature                Int?
  /// Organe réuni ; null pour une réunion à l'initiative d'un député (sous-type DEP).
  organe_uid                 String?   @db.VarChar(50)
  /// Député à l'initiative de la réunion (sous-type DEP).
  demandeur_acteur_uid       String?   @db.VarChar(50)
  /// Organe à l'initiative de la réunion (sous-type GP : groupe politique).
  demandeur_organe_uid       String?   @db.VarChar(50)
  /// Confirmé, Annulé, Eventuel, Supprimé.
  etat                       String?   @db.VarChar(30)
  date_debut                 DateTime  @db.Timestamptz(6)
  date_fin                   DateTime? @db.Timestamptz(6)
  session_ref                String?   @db.VarChar(50)
  /// Compte rendu de la réunion (pont vers les débats pour les séances).
  compte_rendu_ref           String?   @db.VarChar(80)
  lieu_ref                   String?   @db.VarChar(50)
  lieu_libelle               String?   @db.Text
  format_reunion             String?   @db.VarChar(30)
  /// Sous-type d'une réunion à l'initiative d'un parlementaire (GE = groupe d'études, GP = groupe politique, DEP = député).
  sous_type_reunion          String?   @db.VarChar(30)
  visio_conference           Boolean?
  captation_video            Boolean?
  ouverture_presse           Boolean?
  est_reunion_internationale Boolean?
  /// Séances publiques uniquement.
  date_seance                DateTime? @db.Date
  id_jo                      String?   @db.VarChar(20)
  num_seance_jo              Int?
  /// Unique, Première, Deuxième… (séances publiques).
  quantieme                  String?   @db.VarChar(30)
  resume_odj                 String?   @db.Text
  convocation_odj            String?   @db.Text
  legislature_snapshot       Int
  row_hash                   String    @unique @db.Text
  created_at                 DateTime  @default(now()) @db.Timestamp(6)
  updated_at                 DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  participants ReunionsParticipants[]
  points_odj   ReunionsPointsOdj[]

  @@index([organe_uid])
  @@index([demandeur_acteur_uid])
  @@index([date_debut])
  @@index([type_reunion])
  @@index([legislature_snapshot])
  @@map("reunions")
}

/// Liste de présence d'une réunion de commission, reconstruite par l'AN à partir
/// du compte rendu : « Présents » et « Assistaient également à la réunion »
/// (non-membres présents) → présent, « Excusés » → excusé, membre de l'organe
/// cité nulle part → absent. `absent` est donc déduit et `présent` peut viser un
/// non-membre : un taux de présence doit partir des mandats (membre de l'organe
/// à la date), pas de cette liste seule. Les séances publiques n'en ont pas.
/// Détails : src/sql/scripts/reunions/README.md.
/// `acteur_uid` vise `acteurs.uid` sans clé étrangère.
model ReunionsParticipants {
  reunion_uid          String   @db.VarChar(50)
  acteur_uid           String   @db.VarChar(50)
  /// présent | absent | excusé
  presence             String   @db.VarChar(20)
  legislature_snapshot Int
  row_hash             String   @unique @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamp(6)

  reunion Reunions @relation(fields: [reunion_uid], references: [uid], onDelete: Cascade)

  @@id([reunion_uid, acteur_uid])
  @@index([acteur_uid])
  @@index([legislature_snapshot])
  @@map("reunions_participants")
}

/// Point de l'ordre du jour d'une réunion.
model ReunionsPointsOdj {
  uid                  String    @id @db.VarChar(60)
  reunion_uid          String    @db.VarChar(50)
  /// Rang du point dans la réunion (à partir de 0).
  ordre                Int
  type_point           String?   @db.Text
  objet                String?   @db.Text
  etat                 String?   @db.VarChar(30)
  procedure            String?   @db.Text
  nature_travaux       String?   @db.VarChar(20)
  comite_secret        Boolean?
  date_conf_pres       DateTime? @db.Date
  legislature_snapshot Int
  row_hash             String    @unique @db.Text
  created_at           DateTime  @default(now()) @db.Timestamp(6)

  reunion  Reunions                   @relation(fields: [reunion_uid], references: [uid], onDelete: Cascade)
  dossiers ReunionsPointsOdjDossiers[]

  @@index([reunion_uid])
  @@index([legislature_snapshot])
  @@map("reunions_points_odj")
}

/// Dossier législatif traité par un point de l'ordre du jour. `dossier_uid`
/// vise `dossier_parlementaire.uid` sans clé étrangère (dossiers d'autres
/// législatures possibles).
model ReunionsPointsOdjDossiers {
  point_uid            String   @db.VarChar(60)
  reunion_uid          String   @db.VarChar(50)
  dossier_uid          String   @db.VarChar(50)
  legislature_snapshot Int
  row_hash             String   @unique @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)

  point ReunionsPointsOdj @relation(fields: [point_uid], references: [uid], onDelete: Cascade)

  @@id([point_uid, dossier_uid])
  @@index([dossier_uid])
  @@index([reunion_uid])
  @@map("reunions_points_odj_dossiers")
}

// ============================================
// QUESTIONS (au Gouvernement, orales sans débat, écrites)
// ============================================

/// Question parlementaire. QG (au Gouvernement) et QOSD (orale sans débat) sont
/// posées en séance : leur réponse est publiée au JO des débats et
/// `date_reponse` (date du JO) est en général celle de la séance. QE (écrite) : question et réponse
/// publiées au JO des questions, sans passage en séance. `acteur_uid`,
/// `groupe_uid` et `ministere_uid` sans clé étrangère.
/// Détails : src/sql/scripts/questions/README.md.
model Questions {
  uid                         String    @id @db.VarChar(30)
  /// QG | QOSD | QE
  type_question               String    @db.VarChar(10)
  legislature                 Int?
  numero                      Int?
  /// Auteur déclaré (pour une QOSD, la question peut être posée en séance par un suppléant).
  acteur_uid                  String    @db.VarChar(50)
  mandat_uid                  String?   @db.VarChar(50)
  /// Groupe de l'auteur au moment de la question.
  groupe_uid                  String?   @db.VarChar(50)
  groupe_abrege               String?   @db.VarChar(30)
  rubrique                    String?   @db.Text
  tete_analyse                String?   @db.Text
  /// Analyse AN = intitulé court de la question (`analyse` est un mot réservé PostgreSQL).
  libelle_analyse             String?   @db.Text
  /// Ministère interrogé.
  ministere_uid               String?   @db.VarChar(50)
  ministere_abrege            String?   @db.Text
  /// Publication de la question au JO (null pour une QG).
  date_question               DateTime? @db.Date
  texte_question              String?   @db.Text
  /// Date du JO de la réponse. Pour QG et QOSD, en général la date de la séance,
  /// mais parfois le lendemain (~6 % des QG) : voir le README du domaine.
  date_reponse                DateTime? @db.Date
  /// JO_DEBAT (réponse en séance) | JO_QUESTION (réponse écrite).
  type_jo_reponse             String?   @db.VarChar(20)
  page_jo_reponse             String?   @db.VarChar(20)
  texte_reponse               String?   @db.Text
  /// REP_PUB (réponse publiée), AU (retrait auteur), FM (fin de mandat), ANSE (séance annulée)…
  code_cloture                String?   @db.VarChar(20)
  libelle_cloture             String?   @db.Text
  date_cloture                DateTime? @db.Date
  /// Questions écrites : nombre de renouvellements (relances faute de réponse).
  nb_renouvellements          Int       @default(0)
  date_dernier_renouvellement DateTime? @db.Date
  date_signalement            DateTime? @db.Date
  legislature_snapshot        Int
  row_hash                    String    @unique @db.Text
  created_at                  DateTime  @default(now()) @db.Timestamp(6)
  updated_at                  DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  ministeres_attributaires QuestionsMinisteresAttributaires[]

  @@index([acteur_uid])
  @@index([type_question])
  @@index([date_reponse])
  @@index([ministere_uid])
  @@index([legislature_snapshot])
  @@map("questions")
}

/// Ministère auquel une question a été attribuée ; plusieurs lignes quand la
/// question est réattribuée (changement de gouvernement…). `ordre` = rang dans
/// la source.
model QuestionsMinisteresAttributaires {
  question_uid         String    @db.VarChar(30)
  ordre                Int
  ministere_uid        String?   @db.VarChar(50)
  ministere_abrege     String?   @db.Text
  date_jo              DateTime? @db.Date
  legislature_snapshot Int
  row_hash             String    @unique @db.Text
  created_at           DateTime  @default(now()) @db.Timestamp(6)

  question Questions @relation(fields: [question_uid], references: [uid], onDelete: Cascade)

  @@id([question_uid, ordre])
  @@index([ministere_uid])
  @@map("questions_ministeres_attributaires")
}

// ============================================
// DEBATS (comptes rendus intégraux des séances publiques, Syceron)
// ============================================

/// Compte rendu intégral d'une séance publique. `seance_uid` vise
/// `reunions.uid` (type_reunion = 'seance'), sans clé étrangère.
/// Détails : src/sql/scripts/debats/README.md.
model DebatsComptesRendus {
  uid                  String    @id @db.VarChar(40)
  seance_uid           String?   @db.VarChar(50)
  session_ref          String?   @db.VarChar(30)
  /// Ouverture de la séance (heure de Paris).
  date_seance          DateTime? @db.Timestamptz(6)
  /// « jeudi 18 juillet 2024 »
  date_seance_libelle  String?   @db.VarChar(60)
  num_seance           Int?
  /// Unique, Première, Deuxième…
  quantieme            String?   @db.VarChar(30)
  legislature          Int?
  session_libelle      String?   @db.Text
  num_jo               String?   @db.VarChar(20)
  etat                 String?   @db.VarChar(30)
  validite             String?   @db.VarChar(30)
  /// avant_JO…
  version              String?   @db.VarChar(30)
  legislature_snapshot Int
  row_hash             String    @unique @db.Text
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  points        DebatsPoints[]
  interventions DebatsInterventions[]

  @@index([seance_uid])
  @@index([date_seance])
  @@index([legislature_snapshot])
  @@map("debats_comptes_rendus")
}

/// Point de l'ordre du jour d'une séance ; les points s'imbriquent (`parent_id`).
model DebatsPoints {
  /// `id_syceron` du point.
  id                   String   @id @db.VarChar(20)
  compte_rendu_uid     String   @db.VarChar(40)
  parent_id            String?  @db.VarChar(20)
  /// 1 = point de premier niveau.
  profondeur           Int
  /// Rang dans la séance (ordre_absolu_seance).
  ordre                Int?
  valeur_pts_odj       String?  @db.VarChar(20)
  code_grammaire       String?  @db.VarChar(60)
  titre                String?  @db.Text
  legislature_snapshot Int
  row_hash             String   @unique @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)

  compte_rendu DebatsComptesRendus @relation(fields: [compte_rendu_uid], references: [uid], onDelete: Cascade)

  @@index([compte_rendu_uid])
  @@index([parent_id])
  @@map("debats_points")
}

/// Paragraphe d'un compte rendu : prise de parole, interruption
/// (code_grammaire INTERRUPTION_…), annonce de la présidence… Une ligne par
/// paragraphe ; l'ordre réel dans la séance est `ordre`. `acteur_uid` est
/// l'orateur principal ; tous les orateurs sont dans
/// `debats_interventions_orateurs`.
model DebatsInterventions {
  /// `id_syceron` du paragraphe.
  id                   String   @id @db.VarChar(20)
  compte_rendu_uid     String   @db.VarChar(40)
  /// Point englobant ; null hors point (ouverture, fin de séance).
  point_id             String?  @db.VarChar(20)
  ordre                Int?
  /// null si plusieurs orateurs sans orateur principal, orateur collectif ou sans fiche acteur AN.
  acteur_uid           String?  @db.VarChar(50)
  mandat_uid           String?  @db.VarChar(50)
  /// president quand l'orateur préside la séance.
  role_debat           String?  @db.VarChar(20)
  /// PAROLE_GENERIQUE, INTERRUPTION_1_10, DISC_ARTICLES_…, SCRUT_PUB_…
  code_grammaire       String?  @db.VarChar(60)
  code_style           String?  @db.VarChar(40)
  type_debat           String?  @db.VarChar(20)
  /// Orateurs tels qu'imprimés (« M. le président », « Plusieurs députés du groupe RN »).
  orateurs_libelle     String?  @db.Text
  /// Texte sans balises, sauts de ligne conservés.
  texte                String?  @db.Text
  /// Position dans la vidéo de la séance, en secondes.
  stime                Decimal? @db.Decimal(10, 2)
  /// Discussion d'amendement : numéro du texte, article, amendement, sous-amendement, décision.
  bibard               String?  @db.Text
  article              String?  @db.Text
  amendement           String?  @db.Text
  sous_amendement      String?  @db.Text
  amendement_uid       String?  @db.VarChar(60)
  decision             String?  @db.Text
  legislature_snapshot Int
  row_hash             String   @unique @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)

  compte_rendu DebatsComptesRendus           @relation(fields: [compte_rendu_uid], references: [uid], onDelete: Cascade)
  orateurs     DebatsInterventionsOrateurs[]

  @@index([compte_rendu_uid])
  @@index([acteur_uid])
  @@index([point_id])
  @@index([code_grammaire])
  @@map("debats_interventions")
}

/// Orateur d'un paragraphe (un paragraphe peut en compter plusieurs). Brique
/// de présence en hémicycle : un député qui parle ou interrompt est présent.
model DebatsInterventionsOrateurs {
  intervention_id      String   @db.VarChar(20)
  ordre                Int
  /// null pour un orateur collectif ou sans fiche acteur AN (personnalité auditionnée…).
  acteur_uid           String?  @db.VarChar(50)
  nom                  String?  @db.Text
  qualite              String?  @db.Text
  legislature_snapshot Int
  row_hash             String   @unique @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)

  intervention DebatsInterventions @relation(fields: [intervention_id], references: [id], onDelete: Cascade)

  @@id([intervention_id, ordre])
  @@index([acteur_uid])
  @@map("debats_interventions_orateurs")
}

model RefGroupes {
  groupe_id          String   @id @db.VarChar(50)
  groupe_legislature Int
  libelle            String?  @db.VarChar(100)
  code               String?  @db.VarChar(20)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(6)

  groupe GroupesParlementaires @relation(fields: [groupe_id], references: [id])

  @@map("ref_groupes")
}

model RefGroupesFondation {
  id              Int      @id @default(autoincrement())
  groupe_code     String   @unique @db.VarChar(20)
  annee_fondation Int?
  site_officiel   String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("ref_groupes_fondation")
}

model RefScrutinType {
  id                   Int     @id @default(autoincrement())
  type_scrutin_code    String? @db.VarChar(10)
  type_scrutin_libelle String  @db.VarChar(100)

  @@unique([type_scrutin_code, type_scrutin_libelle])
  @@map("ref_scrutin_type")
}

model RefOrganeType {
  id          Int     @id @default(autoincrement())
  type_organe String? @db.VarChar(50)

  @@unique([type_organe])
  @@map("ref_organe_type")
}

model RefActeursPhotos {
  id          Int      @id @default(autoincrement())
  acteurUid   String   @map("acteur_uid") @db.VarChar(50)
  legislature Int      @db.Integer
  photoPath   String   @map("photo_path") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  acteur Acteurs @relation(fields: [acteurUid], references: [uid], onDelete: Cascade)

  @@unique([acteurUid, legislature])
  @@index([acteurUid])
  @@index([legislature])
  @@map("ref_acteurs_photos")
}

// Référentiels manuels : données publiques absentes de l'open data de l'AN,
// saisies et sourcées dans src/sql/scripts/institutions/referentials/.

/// Portraits de personnalités sans photo de député (Président, Premiers ministres
/// non députés…), avec leur crédit : auteur et licence sont à afficher.
/// `photo_path` : chemin servi par le front (dossier public/).
model RefPortraits {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(100)
  /// Identifiant AN (PAxxx) si la personne existe dans `acteurs` ; pas de clé
  /// étrangère : le référentiel ne doit pas dépendre des réimports d'acteurs.
  acteur_uid  String?  @unique @db.VarChar(50)
  photo_path  String   @db.Text
  auteur      String   @db.Text
  licence     String   @db.VarChar(50)
  licence_url String?  @db.Text
  source_url  String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("ref_portraits")
}

/// Mandats présidentiels de la Ve République (dates de début et de fin de
/// mandat, pas d'investiture ; `fin` null = en cours).
model RefMandatsPresidentiels {
  id            Int       @id @default(autoincrement())
  president     String    @db.VarChar(100)
  mandat_numero Int
  debut         DateTime  @unique @db.Date
  fin           DateTime? @db.Date
  /// Clé de `ref_portraits.slug`.
  portrait_slug String?   @db.VarChar(100)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@map("ref_mandats_presidentiels")
}

/// Événements institutionnels marquants (dissolution, élections législatives…).
model RefEvenementsInstitutionnels {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  /// `dissolution` | `elections_legislatives`
  type        String   @db.VarChar(50)
  libelle     String   @db.VarChar(200)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([date, type])
  @@map("ref_evenements_institutionnels")
}

/// Définitions des fonctions institutionnelles (présidence de l'Assemblée,
/// questure, secrétariat du Bureau, rangs du gouvernement…), affichées en
/// bulle d'information dans les organigrammes du front.
model RefFonctionsDefinitions {
  id         Int      @id @default(autoincrement())
  /// Clé lue par le front (ex. `assemblee-questeur`, `ministre-delegue`).
  slug       String   @unique @db.VarChar(50)
  libelle    String   @db.VarChar(100)
  definition String   @db.Text
  /// Texte de référence (ex. « Constitution, art. 12 »).
  source     String?  @db.VarChar(200)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("ref_fonctions_definitions")
}

// ============================================
// AMENDEMENTS
// ============================================

model amendements {
  uid         String  @id
  chronotag   String?
  legislature String?

  numero_long   String?
  numero_ordre  String?
  numero_rect   String?
  organe_examen String?

  examen_ref    String?
  texte_leg_ref String?

  acteur_uid           String?
  groupe_politique_ref String?
  type_auteur          String?

  division_titre       String?
  division_type        String?
  division_avant_apres String?
  alinea_numero        String?

  dispositif      String?
  expose_sommaire String?

  date_depot        DateTime? @db.Date
  date_publication  DateTime? @db.Date
  date_sort         DateTime? @db.Timestamptz
  sort              String?
  etat_code         String?
  etat_libelle      String?
  sous_etat_code    String?
  sous_etat_libelle String?

  article99 Boolean?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  co_auteurs amendements_co_auteurs[]

  @@index([acteur_uid, legislature_snapshot])
}

model amendements_co_auteurs {
  id             Int    @id @default(autoincrement())
  amendement_uid String
  acteur_uid     String

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  amendement amendements @relation(fields: [amendement_uid], references: [uid])

  @@unique([row_hash])
  @@map("amendements_co_auteurs")
}

// ============================================
// DOSSIER PARLEMENTAIRE
// ============================================
model DossierParlementaire {
  uid String @id

  legislature       Int
  titre             String
  titre_chemin      String?
  senat_chemin      String?
  procedure_code    String?
  procedure_libelle String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  initiateurs DossierInitiateur[]
  actes       ActeLegislatif[]

  @@unique([row_hash])
  @@map("dossier_parlementaire")
}

model DossierInitiateur {
  id          Int    @id @default(autoincrement())
  dossier_uid String

  acteur_uid String?
  mandat_uid String?
  organe_uid String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  dossier DossierParlementaire @relation(fields: [dossier_uid], references: [uid])

  @@unique([row_hash])
  @@index([dossier_uid])
  @@map("dossier_initiateur")
}

model ActeLegislatif {
  uid String @id

  dossier_uid     String
  parent_acte_uid String?

  type_acte     String
  code_acte     String?
  nom_canonique String?
  libelle_court String?
  organe_uid    String?
  date_acte     DateTime?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  rapporteurs     ActeRapporteur[]
  textes_associes ActeTexteAssocie[]
  reunion         ActeReunion?
  votes           ActeVote[]
  decision        ActeDecision?

  parent_acte ActeLegislatif?      @relation("ActeHierarchy", fields: [parent_acte_uid], references: [uid])
  enfants     ActeLegislatif[]     @relation("ActeHierarchy")
  dossier     DossierParlementaire @relation(fields: [dossier_uid], references: [uid])

  @@unique([row_hash])
  @@index([dossier_uid])
  @@index([parent_acte_uid])
  @@map("acte_legislatif")
}

model ActeRapporteur {
  acte_uid   String
  acteur_uid String

  type_rapporteur String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  acte ActeLegislatif @relation(fields: [acte_uid], references: [uid])

  @@id([acte_uid, acteur_uid])
  @@unique([row_hash])
  @@map("acte_rapporteur")
}

model ActeTexteAssocie {
