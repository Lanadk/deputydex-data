  reunion_ref String?
  odj_ref     String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  acte ActeLegislatif @relation(fields: [acte_uid], references: [uid])

  @@id([acte_uid])
  @@unique([row_hash])
  @@map("acte_reunion")
}

model ActeVote {
  acte_uid String
  vote_ref String

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  acte ActeLegislatif @relation(fields: [acte_uid], references: [uid])

