generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}
// test de synchro
// ============================================
// AN - MANAGEMENT
// ============================================
model ParamLegislature {
  id        Int       @id @default(autoincrement())
  number    Int       @unique
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  currentLegislatures ParamCurrentLegislature[]
  dataSources         ParamDataSource[]

  @@map("param_legislatures")
}

model ParamCurrentLegislature {
  legislatureId Int              @id @map("legislature_id")
  number        Int
  updatedAt     DateTime         @default(now()) @updatedAt @map("updated_at")
  legislature   ParamLegislature @relation(fields: [legislatureId], references: [id])

  @@map("param_current_legislatures")
}

model RefDataDomain {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  description String?

  dataSources ParamDataSource[]

  @@map("ref_data_domains")
}

model ParamDataSource {
  id            Int      @id @default(autoincrement())
  domainId      Int      @map("domain_id")
  legislatureId Int      @map("legislature_id")
  downloadUrl   String   @map("download_url")
  fileName      String   @map("file_name")
  createdAt     DateTime @default(now()) @map("created_at")

  domain      RefDataDomain         @relation(fields: [domainId], references: [id])
  legislature ParamLegislature      @relation(fields: [legislatureId], references: [id])
  downloads   MonitorDataDownload[]

  @@unique([domainId, legislatureId])
  @@map("param_data_sources")
}

model MonitorDataDownload {
  id             Int       @id @default(autoincrement())
  sourceId       Int       @map("source_id")
  fileName       String?   @map("file_name")
  downloaded     Boolean   @default(false)
  lastDownloadAt DateTime? @map("last_download_at")
  checksum       String?
  fileSize       BigInt?   @map("file_size")
  errorMessage   String?   @map("error_message")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  source ParamDataSource @relation(fields: [sourceId], references: [id])

  @@unique([sourceId])
  @@map("monitor_data_download")
}

model MonitorDataSetsUpdate {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  @@map("monitor_data_set_update")
}

// ============================================
// ACTEURS
// ============================================
model Acteurs {
  uid                   String    @id @db.VarChar(50)
  civilite              String?   @db.VarChar(10)
  prenom                String?   @db.VarChar(100)
  nom                   String?   @db.VarChar(255)
  nom_alpha             String?   @db.VarChar(255)
  trigramme             String?   @db.VarChar(10)
  date_naissance        DateTime? @db.Date
  ville_naissance       String?   @db.VarChar(255)
  departement_naissance String?   @db.VarChar(255)
  pays_naissance        String?   @db.VarChar(255)
  date_deces            DateTime? @db.Date
  profession_libelle    String?   @db.VarChar(255)
  profession_categorie  String?   @db.VarChar(255)
  profession_famille    String?   @db.VarChar(255)
  uri_hatvp             String?   @db.Text
  created_at            DateTime  @default(now()) @db.Timestamp(6)
  row_hash              String    @db.Text
  legislature_snapshot  Int       @db.Integer

  adressesPostales ActeursAdressesPostales[]
  adressesMails    ActeursAdressesMails[]
  reseauxSociaux   ActeursReseauxSociaux[]
  telephones       ActeursTelephones[]
  mandats          Mandats[]
  photos           RefActeursPhotos[]
  groupes          ActeursGroupes[]

  @@unique([row_hash])
  @@map("acteurs")
}

model ActeursAdressesPostales {
  id                   Int      @id @default(autoincrement())
  acteur_uid           String   @db.VarChar(50)
  uid_adresse          String   @db.VarChar(50)
  type_code            String?  @db.VarChar(10)
  type_libelle         String?  @db.VarChar(255)
  intitule             String?  @db.VarChar(255)
  numero_rue           String?  @db.VarChar(50)
  nom_rue              String?  @db.VarChar(255)
  complement_adresse   String?  @db.VarChar(255)
  code_postal          String?  @db.VarChar(10)
  ville                String?  @db.VarChar(255)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  acteur Acteurs @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([uid_adresse])
  @@map("acteurs_adresses_postales")
}

model ActeursAdressesMails {
  id                   Int      @id @default(autoincrement())
  acteur_uid           String   @db.VarChar(50)
  uid_adresse          String   @db.VarChar(50)
  type_code            String?  @db.VarChar(10)
  type_libelle         String?  @db.VarChar(255)
  email                String?  @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  acteur Acteurs @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([uid_adresse])
  @@map("acteurs_adresses_mails")
}

model ActeursReseauxSociaux {
  id                   Int      @id @default(autoincrement())
  acteur_uid           String   @db.VarChar(50)
  uid_adresse          String   @db.VarChar(50)
  type_code            String?  @db.VarChar(10)
  type_libelle         String?  @db.VarChar(255)
  plateforme           String?  @db.VarChar(50)
  identifiant          String?  @db.Text
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  acteur Acteurs @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([uid_adresse])
  @@map("acteurs_reseaux_sociaux")
}

model ActeursTelephones {
  id                   Int      @id @default(autoincrement())
  acteur_uid           String   @db.VarChar(50)
  uid_adresse          String   @db.VarChar(50)
  type_code            String?  @db.VarChar(10)
  type_libelle         String?  @db.VarChar(255)
  adresse_rattachement String?  @db.VarChar(50)
  numero               String?  @db.VarChar(100)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  acteur Acteurs @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([uid_adresse])
  @@map("acteurs_telephones")
}

model ActeursGroupes {
  id                   Int       @id @default(autoincrement())
  acteur_uid           String    @db.VarChar(50)
  groupe_id            String    @db.VarChar(50)
  groupe_legislature   Int
  date_debut           DateTime  @db.Date
  date_fin             DateTime? @db.Date
  legislature_snapshot Int       @db.Integer
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  row_hash             String    @db.Text

  acteur Acteurs               @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)
  groupe GroupesParlementaires @relation(fields: [groupe_id], references: [id])

  @@unique([row_hash])
  @@unique([acteur_uid, groupe_id, date_debut])
  @@index([acteur_uid])
  @@index([groupe_id])
  @@index([legislature_snapshot])
  @@map("acteurs_groupes")
}

// ============================================
// DÉPUTÉS & SCRUTINS
// ============================================
model Deputes {
  id                   String   @id @db.VarChar(50)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  votes VotesDeputes[]

  @@unique([row_hash])
  @@unique([id])
  @@map("deputes")
}

model Scrutins {
  uid                  String    @id @db.VarChar(50)
  numero               String?   @db.VarChar(10)
  legislature          String?   @db.VarChar(10)
  date_scrutin         DateTime? @db.Date
  titre                String?   @db.Text
  type_scrutin_code    String?   @db.VarChar(10)
  type_scrutin_libelle String?   @db.VarChar(255)
  type_majorite        String?   @db.Text
  resultat_code        String?   @db.VarChar(50)
  resultat_libelle     String?   @db.Text
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  row_hash             String    @db.Text
  legislature_snapshot Int       @db.Integer

  scrutinsGroupes         ScrutinsGroupes[]
  votesDeputes            VotesDeputes[]
  agregats                ScrutinsAgregats?
  scrutinsGroupesAgregats ScrutinsGroupesAgregats[]

  @@unique([row_hash])
  @@unique([uid]) // Un scrutin est unique
  @@index([legislature_snapshot])
  @@map("scrutins")
}

model ScrutinsGroupes {
  id                   Int      @id @default(autoincrement())
  scrutin_uid          String   @db.VarChar(50)
  groupe_id            String   @db.VarChar(50)
  groupe_legislature   Int
  nombre_membres       Int?
  position_majoritaire String?  @db.VarChar(50)
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  scrutin Scrutins              @relation(fields: [scrutin_uid], references: [uid], onDelete: Cascade)
  groupe  GroupesParlementaires @relation(fields: [groupe_id], references: [id])

  @@unique([row_hash])
  @@unique([scrutin_uid, groupe_id]) // Un groupe ne peut apparaître qu'une fois par scrutin
  @@index([scrutin_uid])
  @@index([legislature_snapshot])
  @@map("scrutins_groupes")
}

model VotesDeputes {
  id                   Int      @id @default(autoincrement())
  scrutin_uid          String   @db.VarChar(50)
  depute_id            String   @db.VarChar(50)
  groupe_id            String?  @db.VarChar(50)
  groupe_legislature   Int?
  mandat_ref           String?  @db.VarChar(50)
  position             String   @db.VarChar(20)
  cause_position       String?  @db.VarChar(10)
  par_delegation       Boolean?
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text
  legislature_snapshot Int      @db.Integer

  scrutin Scrutins               @relation(fields: [scrutin_uid], references: [uid], onDelete: Cascade)
  depute  Deputes                @relation(fields: [depute_id], references: [id])
  groupe  GroupesParlementaires? @relation(fields: [groupe_id], references: [id])

  @@unique([row_hash])
  @@unique([scrutin_uid, depute_id]) // Un député ne peut voter qu'une fois par scrutin
  @@index([scrutin_uid])
  @@index([depute_id])
  @@index([legislature_snapshot])
  @@index([groupe_id])
  @@map("votes_deputes")
}

model ScrutinsAgregats {
  scrutin_uid                   String   @id @db.VarChar(50)
  nombre_votants                Int?
  suffrages_exprimes            Int?
  suffrages_requis              Int?
  total_pour                    Int?
  total_contre                  Int?
  total_abstentions             Int?
  total_non_votants             Int?
  total_non_votants_volontaires Int?
  created_at                    DateTime @default(now()) @db.Timestamp(6)
  row_hash                      String   @db.Text
  legislature_snapshot          Int      @db.Integer

  scrutin Scrutins @relation(fields: [scrutin_uid], references: [uid], onDelete: Cascade)

  @@unique([row_hash])
  @@unique([scrutin_uid]) // Un scrutin ne peut avoir qu'un agrégat
  @@index([legislature_snapshot])
  @@map("scrutins_agregats")
}

model ScrutinsGroupesAgregats {
  id                      Int      @id @default(autoincrement())
  scrutin_uid             String   @db.VarChar(50)
  groupe_id               String   @db.VarChar(50)
  groupe_legislature      Int
  pour                    Int?
  contre                  Int?
  abstentions             Int?
  non_votants             Int?
  non_votants_volontaires Int?
  created_at              DateTime @default(now()) @db.Timestamp(6)
  row_hash                String   @db.Text
  legislature_snapshot    Int      @db.Integer

  scrutin Scrutins              @relation(fields: [scrutin_uid], references: [uid], onDelete: Cascade)
  groupe  GroupesParlementaires @relation(fields: [groupe_id], references: [id])

  @@unique([row_hash])
  @@unique([scrutin_uid, groupe_id]) // Un groupe ne peut avoir qu'un agrégat par scrutin
  @@index([scrutin_uid])
  @@index([legislature_snapshot])
  @@map("scrutins_groupes_agregats")
}

// ============================================
// MANDATS
// ============================================
model Mandats {
  uid                           String    @id @db.VarChar(50)
  acteur_uid                    String    @db.VarChar(50)
  legislature                   Int
  type_organe                   String    @db.VarChar(50)
  date_debut                    DateTime  @db.Date
  date_fin                      DateTime? @db.Date
  date_publication              DateTime? @db.Date
  preseance                     Int
  nomin_principale              Int
  code_qualite                  String    @db.VarChar(100)
  lib_qualite                   String    @db.VarChar(255)
  lib_qualite_sex               String    @db.VarChar(255)
  organe_uid                    String    @db.VarChar(100)
  election_region               String?   @db.VarChar(255)
  election_region_type          String?   @db.VarChar(100)
  election_departement          String?   @db.VarChar(255)
  election_num_departement      String?   @db.VarChar(10)
  election_num_circo            String?   @db.VarChar(10)
  election_cause_mandat         String?   @db.VarChar(255)
  election_ref_circonscription  String?   @db.VarChar(255)
  mandature_date_prise_fonction DateTime? @db.Date
  mandature_cause_fin           String?   @db.VarChar(255)
  mandature_premiere_election   Boolean?
  mandature_place_hemicycle     String?   @db.VarChar(10)
  mandature_mandat_remplace_ref String?   @db.VarChar(100)
  created_at                    DateTime  @default(now()) @db.Timestamp(6)
  row_hash                      String    @db.Text
  legislature_snapshot          Int       @db.Integer

  acteur     Acteurs             @relation(fields: [acteur_uid], references: [uid], onDelete: Cascade)
  suppleants MandatsSuppleants[]

  @@unique([row_hash])
  @@index([acteur_uid])
  @@index([legislature_snapshot])
  @@map("mandats")
}

model MandatsSuppleants {
  id                   Int       @id @default(autoincrement())
  mandat_uid           String    @db.VarChar(50)
  suppleant_uid        String    @db.VarChar(50)
  date_debut           DateTime  @db.Date
  date_fin             DateTime? @db.Date
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  row_hash             String    @db.Text
  legislature_snapshot Int       @db.Integer

  mandat Mandats @relation(fields: [mandat_uid], references: [uid], onDelete: Cascade)

  @@unique([mandat_uid, suppleant_uid])
  @@unique([row_hash])
  @@index([legislature_snapshot])
  @@map("mandats_suppleants")
}

// ============================================
// RÉFÉRENTIELS
// ============================================

model GroupesParlementaires {
  id                   String   @id @db.VarChar(50)
  legislature_snapshot Int      @db.Integer
  created_at           DateTime @default(now()) @db.Timestamp(6)
  row_hash             String   @db.Text

  refGroupes              RefGroupes[]
  acteursGroupes          ActeursGroupes[]
  scrutinsGroupes         ScrutinsGroupes[]
  votesDeputes            VotesDeputes[]
  scrutinsGroupesAgregats ScrutinsGroupesAgregats[]

  @@unique([row_hash])
  @@map("groupes_parlementaires")
}

/// Organes de l'Assemblée nationale (jeu AMO, fichiers `acteurs/json/organe`) :
/// commissions (COMPER…), groupes (GP), ministères (MINISTERE), gouvernements
/// (GOUVERNEMENT), Présidence de la République (PRESREP)… Référencés par
/// `mandats.organe_uid`, sans clé étrangère : un mandat peut viser un organe
/// absent des archives importées.
model Organes {
  uid                  String    @id @db.VarChar(50)
  code_type            String    @db.VarChar(30)
  libelle              String?   @db.Text
  /// Forme à insérer dans une phrase : « de la commission des finances ».
  libelle_edition      String?   @db.Text
  /// Forme courte : « Finances », « Intérieur ».
  libelle_abrege       String?   @db.Text
  /// Sigle : « CION_FIN », « INT ».
  libelle_abrev        String?   @db.VarChar(50)
  date_debut           DateTime? @db.Date
  date_fin             DateTime? @db.Date
  /// Organe parent (ex. le gouvernement d'un ministère).
  organe_parent_uid    String?   @db.VarChar(50)
  /// Organe précédent (ex. le même ministère dans le gouvernement précédent).
  organe_precedent_uid String?   @db.VarChar(50)
  /// Rang protocolaire (ministères).
  preseance            Int?
  /// Législature de l'organe ; null pour un organe permanent.
  legislature          Int?
  legislature_snapshot Int
  row_hash             String    @unique @db.Text
  created_at           DateTime  @default(now()) @db.Timestamp(6)
  updated_at           DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@index([code_type])
  @@index([organe_parent_uid])
  @@map("organes")
}

model RefGroupes {
  groupe_id          String   @id @db.VarChar(50)
  groupe_legislature Int
  libelle            String?  @db.VarChar(100)
  code               String?  @db.VarChar(20)
  created_at         DateTime @default(now()) @db.Timestamp(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamp(6)

  groupe GroupesParlementaires @relation(fields: [groupe_id], references: [id])

  @@map("ref_groupes")
}

model RefGroupesFondation {
  id              Int      @id @default(autoincrement())
  groupe_code     String   @unique @db.VarChar(20)
  annee_fondation Int?
  site_officiel   String?  @db.Text
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("ref_groupes_fondation")
}

model RefScrutinType {
  id                   Int     @id @default(autoincrement())
  type_scrutin_code    String? @db.VarChar(10)
  type_scrutin_libelle String  @db.VarChar(100)

  @@unique([type_scrutin_code, type_scrutin_libelle])
  @@map("ref_scrutin_type")
}

model RefOrganeType {
  id          Int     @id @default(autoincrement())
  type_organe String? @db.VarChar(50)

  @@unique([type_organe])
  @@map("ref_organe_type")
}

model RefActeursPhotos {
  id          Int      @id @default(autoincrement())
  acteurUid   String   @map("acteur_uid") @db.VarChar(50)
  legislature Int      @db.Integer
  photoPath   String   @map("photo_path") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  acteur Acteurs @relation(fields: [acteurUid], references: [uid], onDelete: Cascade)

  @@unique([acteurUid, legislature])
  @@index([acteurUid])
  @@index([legislature])
  @@map("ref_acteurs_photos")
}

// Référentiels manuels : données publiques absentes de l'open data de l'AN,
// saisies et sourcées dans src/sql/scripts/institutions/referentials/.

/// Portraits de personnalités sans photo de député (Président, Premiers ministres
/// non députés…), avec leur crédit : auteur et licence sont à afficher.
/// `photo_path` : chemin servi par le front (dossier public/).
model RefPortraits {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(100)
  /// Identifiant AN (PAxxx) si la personne existe dans `acteurs` ; pas de clé
  /// étrangère : le référentiel ne doit pas dépendre des réimports d'acteurs.
  acteur_uid  String?  @unique @db.VarChar(50)
  photo_path  String   @db.Text
  auteur      String   @db.Text
  licence     String   @db.VarChar(50)
  licence_url String?  @db.Text
  source_url  String   @db.Text
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("ref_portraits")
}

/// Mandats présidentiels de la Ve République (dates de début et de fin de
/// mandat, pas d'investiture ; `fin` null = en cours).
model RefMandatsPresidentiels {
  id            Int       @id @default(autoincrement())
  president     String    @db.VarChar(100)
  mandat_numero Int
  debut         DateTime  @unique @db.Date
  fin           DateTime? @db.Date
  /// Clé de `ref_portraits.slug`.
  portrait_slug String?   @db.VarChar(100)
  created_at    DateTime  @default(now()) @db.Timestamp(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamp(6)

  @@map("ref_mandats_presidentiels")
}

/// Événements institutionnels marquants (dissolution, élections législatives…).
model RefEvenementsInstitutionnels {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  /// `dissolution` | `elections_legislatives`
  type        String   @db.VarChar(50)
  libelle     String   @db.VarChar(200)
  created_at  DateTime @default(now()) @db.Timestamp(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@unique([date, type])
  @@map("ref_evenements_institutionnels")
}

/// Définitions des fonctions institutionnelles (présidence de l'Assemblée,
/// questure, secrétariat du Bureau, rangs du gouvernement…), affichées en
/// bulle d'information dans les organigrammes du front.
model RefFonctionsDefinitions {
  id         Int      @id @default(autoincrement())
  /// Clé lue par le front (ex. `assemblee-questeur`, `ministre-delegue`).
  slug       String   @unique @db.VarChar(50)
  libelle    String   @db.VarChar(100)
  definition String   @db.Text
  /// Texte de référence (ex. « Constitution, art. 12 »).
  source     String?  @db.VarChar(200)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)

  @@map("ref_fonctions_definitions")
}

// ============================================
// AMENDEMENTS
// ============================================

model amendements {
  uid         String  @id
  chronotag   String?
  legislature String?

  numero_long   String?
  numero_ordre  String?
  numero_rect   String?
  organe_examen String?

  examen_ref    String?
  texte_leg_ref String?

  acteur_uid           String?
  groupe_politique_ref String?
  type_auteur          String?

  division_titre       String?
  division_type        String?
  division_avant_apres String?
  alinea_numero        String?

  dispositif      String?
  expose_sommaire String?

  date_depot        DateTime? @db.Date
  date_publication  DateTime? @db.Date
  date_sort         DateTime? @db.Timestamptz
  sort              String?
  etat_code         String?
  etat_libelle      String?
  sous_etat_code    String?
  sous_etat_libelle String?

  article99 Boolean?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  co_auteurs amendements_co_auteurs[]

  @@index([acteur_uid, legislature_snapshot])
}

model amendements_co_auteurs {
  id             Int    @id @default(autoincrement())
  amendement_uid String
  acteur_uid     String

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  amendement amendements @relation(fields: [amendement_uid], references: [uid])

  @@unique([row_hash])
  @@map("amendements_co_auteurs")
}

// ============================================
// DOSSIER PARLEMENTAIRE
// ============================================
model DossierParlementaire {
  uid String @id

  legislature       Int
  titre             String
  titre_chemin      String?
  senat_chemin      String?
  procedure_code    String?
  procedure_libelle String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  initiateurs DossierInitiateur[]
  actes       ActeLegislatif[]

  @@unique([row_hash])
  @@map("dossier_parlementaire")
}

model DossierInitiateur {
  id          Int    @id @default(autoincrement())
  dossier_uid String

  acteur_uid String?
  mandat_uid String?
  organe_uid String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  dossier DossierParlementaire @relation(fields: [dossier_uid], references: [uid])

  @@unique([row_hash])
  @@index([dossier_uid])
  @@map("dossier_initiateur")
}

model ActeLegislatif {
  uid String @id

  dossier_uid     String
  parent_acte_uid String?

  type_acte     String
  code_acte     String?
  nom_canonique String?
  libelle_court String?
  organe_uid    String?
  date_acte     DateTime?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  rapporteurs     ActeRapporteur[]
  textes_associes ActeTexteAssocie[]
  reunion         ActeReunion?
  votes           ActeVote[]
  decision        ActeDecision?

  parent_acte ActeLegislatif?      @relation("ActeHierarchy", fields: [parent_acte_uid], references: [uid])
  enfants     ActeLegislatif[]     @relation("ActeHierarchy")
  dossier     DossierParlementaire @relation(fields: [dossier_uid], references: [uid])

  @@unique([row_hash])
  @@index([dossier_uid])
  @@index([parent_acte_uid])
  @@map("acte_legislatif")
}

model ActeRapporteur {
  acte_uid   String
  acteur_uid String

  type_rapporteur String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  acte ActeLegislatif @relation(fields: [acte_uid], references: [uid])

  @@id([acte_uid, acteur_uid])
  @@unique([row_hash])
  @@map("acte_rapporteur")
}

model ActeTexteAssocie {
  acte_uid        String
  reference_texte String
  type_texte      String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  acte ActeLegislatif @relation(fields: [acte_uid], references: [uid])

  @@id([acte_uid, reference_texte])
  @@unique([row_hash])
  @@map("acte_texte_associe")
}

model ActeReunion {
  acte_uid    String
  reunion_ref String?
  odj_ref     String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  acte ActeLegislatif @relation(fields: [acte_uid], references: [uid])

  @@id([acte_uid])
  @@unique([row_hash])
  @@map("acte_reunion")
}

model ActeVote {
  acte_uid String
  vote_ref String

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  acte ActeLegislatif @relation(fields: [acte_uid], references: [uid])

  @@id([acte_uid, vote_ref])
  @@unique([row_hash])
  @@map("acte_vote")
}

model ActeDecision {
  acte_uid String

  famille_code String?
  libelle      String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  acte ActeLegislatif @relation(fields: [acte_uid], references: [uid])

  @@id([acte_uid])
  @@unique([row_hash])
  @@map("acte_decision")
}

// ============================================
// DOCUMENTS PARLEMENTAIRE
// ============================================
model documents {
  uid         String @id
  legislature Int?

  denomination_structurelle String?
  provenance                String?
  titre_principal           String?
  titre_principal_court     String?

  dossier_ref String?
  redacteur   String?

  date_creation        DateTime? @db.Date
  date_depot           DateTime? @db.Date
  date_publication     DateTime? @db.Date
  date_publication_web DateTime? @db.Date

  num_notice        String?
  formule           String?
  adoption_conforme Boolean?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  classification    documents_classifications?
  auteurs           documents_auteurs[]
  co_signataires    documents_co_signataires[]
  organes_referents documents_organes_referents[]
  imprimerie        documents_imprimeries?
  depot_amendements documents_depot_amendements[]

  @@unique([row_hash])
  @@index([uid])
  @@map("documents_parlementaires")
}

model documents_classifications {
  document_uid String

  depot_code    String?
  depot_libelle String?

  classe_code    String?
  classe_libelle String?

  type_code    String?
  type_libelle String?

  sous_type_code            String?
  sous_type_libelle         String?
  sous_type_libelle_edition String?

  statut_adoption_code    String?
  statut_adoption_libelle String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  document documents @relation(fields: [document_uid], references: [uid])

  @@id([document_uid])
  @@unique([row_hash])
  @@index([document_uid])
  @@map("documents_classifications")
}

model documents_auteurs {
  id           Int    @id @default(autoincrement())
  document_uid String

  acteur_uid String?
  organe_uid String?
  qualite    String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  document documents @relation(fields: [document_uid], references: [uid])

  @@unique([row_hash])
  @@index([document_uid])
  @@map("documents_auteurs")
}

model documents_co_signataires {
  id           Int    @id @default(autoincrement())
  document_uid String

  acteur_uid String?
  organe_uid String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  document documents @relation(fields: [document_uid], references: [uid])

  @@unique([row_hash])
  @@index([document_uid])
  @@map("documents_co_signataires")
}

model documents_organes_referents {
  id           Int    @id @default(autoincrement())
  document_uid String
  organe_uid   String

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  document documents @relation(fields: [document_uid], references: [uid])

  @@unique([row_hash])
  @@map("documents_organes_referents")
}

model documents_imprimeries {
  document_uid String @id

  issn String?
  isbn String?
  dian String?

  nb_page Int?
  prix    String?

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  document documents @relation(fields: [document_uid], references: [uid])

  @@unique([row_hash])
  @@index([document_uid])
  @@map("documents_imprimeries")
}

model documents_depot_amendements {
  id           Int    @id @default(autoincrement())
  document_uid String

  type_depot String // 'SEANCE' | 'COMMISSION'
  organe_uid String?
  amendable  Boolean?

  date_limite_depot DateTime? @db.Date

  row_hash             String @db.Text
  legislature_snapshot Int    @db.Integer

  document documents @relation(fields: [document_uid], references: [uid])

  @@unique([row_hash])
  @@index([document_uid])
  @@map("documents_depot_amendements")
}
